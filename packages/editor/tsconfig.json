{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "outDir": "./dist",
        "rootDir": "./src",
        "declaration": true,
        "declarationMap": true,
        "composite": true,
        "paths": {
            "@/components": ["packages/editor/src/external/components/index"],
            "@/components/*": ["packages/editor/src/external/components/*"],
            "@/core": ["packages/editor/src/external/core/index"],
            "@/core/*": ["packages/editor/src/external/core/*"],
            "@/consts/*": ["packages/editor/src/consts/*"],
            "@/consts": ["packages/editor/src/consts"],
            "@/utils/*": ["packages/editor/src/utils/*"],
            "@/utils": ["packages/editor/src/utils"],
            "@/api/*": ["packages/editor/src/external/api/*"],
            "@/api": ["packages/editor/src/external/api"],
            "@/services/*": ["packages/editor/src/external/api/services/*"]
        }
    },
    "include": [
        "src"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}
