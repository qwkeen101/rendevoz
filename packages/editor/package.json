{
    "name": "@rendevoz/editor",
    "version": "0.1.0",
    "description": "A powerful rich text editor based on Slate",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": "./dist/index.js"
    },
    "scripts": {
        "build": "tsc",
        "dev": "tsc --watch",
        "type-check": "tsc --noEmit",
        "clean": "rm -rf dist"
    },
    "keywords": [
        "react",
        "editor",
        "slate",
        "wysiwyg",
        "rich-text"
    ],
    "license": "MIT",
    "peerDependencies": {
        "react": "^18.0.0",
        "react-dom": "^18.0.0",
        "slate": "^0.103.0",
        "slate-react": "^0.82.2",
        "jotai": "^2.11.0"
    },
    "dependencies": {
        "slate-history": "^0.109.0",
        "slate-hyperscript": "^0.100.0",
        "is-hotkey": "^0.2.0",
        "@rendevoz/shared": "*"
    },
    "devDependencies": {
        "@types/react": "^18.0.0",
        "@types/react-dom": "^18.0.0",
        "typescript": "^5.6.3"
    }
}