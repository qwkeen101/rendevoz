{
  appId: "Rendevoz",
  productName: "Rendevoz",
  copyright: "Copyright © 2022 RealRong",
  asar: true,
  directories: {
    output: "release/${version}"
  },
  publish: {
      provider: "github",
      repo: "Rendevoz_public_repo",
      owner: "RealRong",
      releaseType: "release"
  },
  files: [
    "dist-electron",
    "dist"
  ],
  win: {
    target: [
      {
        target: "nsis",
        arch: ["x64"],
      },
    ],
    artifactName: "Rendevoz-Windows-Setup.${ext}",
  },
  nsis: {
    oneClick: false,
    perMachine: false,
    allowToChangeInstallationDirectory: true,
    deleteAppDataOnUninstall: false,
  },
  mac: {
    target: ["dmg"],
    artifactName: "Rendevoz-MacOS-Setup.${ext}",
  },
  linux: {
    icon: "electron/resources/iconset",
    target: ["AppImage", "deb"],
    artifactName: "${productName}-Linux-${version}.${ext}",
  },
}
