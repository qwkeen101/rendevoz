{
  appId: "rendevoz",
  productName: "Rendevoz",
  copyright: "Copyright © 2023 Rendevoz",
  asar: true,
  directories: {
    output: "release"
  },
  // Where installed copies look for updates (written into app-update.yml).
  // Tagged builds upload here as a draft release; nothing reaches users
  // until the draft is published on GitHub. The github provider only works
  // while this repo is public; before making it private, move releases to a
  // separate public repo and change owner/repo here.
  publish: {
      provider: "github",
      owner: "qwkeen101",
      repo: "rendevoz",
      releaseType: "draft"
  },
  // Vite bundles the renderer and most of the main process. electron-builder
  // also packs package.json "dependencies" (plus what they depend on), so that
  // list holds only the native modules the main process loads at runtime
  // (the externals in vite.config.ts: usearch, onnxruntime-*, sharp);
  // everything Vite bundles belongs in devDependencies.
  files: [
    "dist-electron",
    "dist"
  ],
  protocols: {
    name: "rendevoz",
    schemes: [
      "rendevoz"
    ]
  },
  win: {
    target: [
      {
        target: "nsis",
        arch: ["x64"],
      },
    ],
    artifactName: "Rendevoz-Windows-Setup.${ext}",
    // drop the other platforms' native binaries (~230 MB of onnxruntime)
    files: [
      "!node_modules/onnxruntime-node/bin/napi-v*/{linux,darwin}/**",
      "!node_modules/onnxruntime-node/bin/napi-v*/win32/arm64/**",
      "!node_modules/usearch/prebuilds/{linux,darwin}-*/**",
      "!node_modules/usearch/numkong/**",
    ],
  },
  nsis: {
    oneClick: false,
    perMachine: false,
    allowToChangeInstallationDirectory: true,
    deleteAppDataOnUninstall: false,
  },
  nodeGypRebuild: false,
  npmRebuild: false,
  afterSign: "electron-builder-notarize",
  mac: {
    target: ["default"],
    artifactName: "Rendevoz-MacOS-Setup.${ext}",
    hardenedRuntime: true,
    entitlements: "./entitlements.mac.plist",
    entitlementsInherit: "./entitlements.mac.plist",
    gatekeeperAssess: false
  },
  linux: {
    target: ["AppImage"],
    artifactName: "Rendevoz-Linux-Setup.${ext}",
  },
}
