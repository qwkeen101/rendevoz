{
  appId: "rendevoz",
  productName: "Rendevoz",
  copyright: "Copyright © 2022 RealRong",
  asar: true,
  directories: {
    output: "release/${version}",
    buildResources: "electron/resources",
  },
  publish: {
      provider: "github",
      repo: "RendevozPublic",
      owner: "Rendevoz",
      releaseType: "release"
  },
  files: [
    "dist-electron",
    "dist",
    "!node_modules"
  ],
  protocols: {
    name: "rendevoz",
    schemes: [
      "rendevoz"
    ]
  },
  win: {
    target: [
      {
        target: "nsis",
        arch: ["x64"],
      },
    ],
    artifactName: "Rendevoz-Windows-Setup.${ext}",
  },
  nsis: {
    oneClick: false,
    perMachine: false,
    allowToChangeInstallationDirectory: true,
    deleteAppDataOnUninstall: false,
  },
  nodeGypRebuild: false,
  npmRebuild: false,
  afterSign: "electron-builder-notarize",
  mac: {
    target: ["default"],
    artifactName: "Rendevoz-MacOS-Setup.${ext}",
    hardenedRuntime: true,
    entitlements: "./entitlements.mac.plist",
    entitlementsInherit: "./entitlements.mac.plist",
    gatekeeperAssess: false
  },
  linux: {
    icon: "electron/resources/iconset",
    target: ["AppImage", "deb"],
    artifactName: "${productName}-Linux-${version}.${ext}",
  },
}
