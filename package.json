{
  "name": "rendevoz-monorepo",
  "productName": "Rendevoz",
  "private": true,
  "version": "1.4.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "author": {
    "name": "Rendevoz Team",
    "email": "rendevoz@rendevoz.com"
  },
  "main": "dist-electron/main/index.js",
  "debug": {
    "env": {
      "VITE_DEV_SERVER_URL": "http://127.0.0.1:7777/"
    }
  },
  "scripts": {
    "dev": "vite",
    "testBuild": "cross-env NODE_OPTIONS=--max-old-space-size=8192 vite build --debug",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=8192 vite build",
    "installDep": "npx -p typescript tsc ./_rendevoz/src/**/*.ts --jsx react-jsx --declaration --emitDeclarationOnly --outDir ./_rendevoz/types ; cd ./_rendevoz && npm run pub",
    "publishMac": "cross-env NODE_OPTIONS=--max-old-space-size=8192 vite build && electron-builder --universal",
    "publishWindows": "cross-env NODE_OPTIONS=--max-old-space-size=8192 vite build && electron-builder --win",
    "publish": "cross-env NODE_OPTIONS=--max-old-space-size=8192 vite build && electron-builder",
    "publishMulti": "npm run publishMac && npm run publishWindows"
  },
  "overrides": {
    "canvas": "../_EXCLUDED_"
  },
  "engines": {
    "node": ">=18"
  },
