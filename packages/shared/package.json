{
    "name": "@rendevoz/shared",
    "version": "0.1.0",
    "description": "Shared utilities, hooks, and components for Rendevoz packages",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": "./dist/index.js",
        "./hooks": "./dist/hooks/index.js",
        "./utils": "./dist/utils/index.js",
        "./types": "./dist/types/index.js",
        "./components": "./dist/components/index.js"
    },
    "scripts": {
        "build": "tsc",
        "dev": "tsc --watch",
        "type-check": "tsc --noEmit",
        "clean": "rm -rf dist"
    },
    "keywords": [
        "react",
        "utilities",
        "components",
        "hooks"
    ],
    "license": "MIT",
    "peerDependencies": {
        "react": "^18.0.0",
        "react-dom": "^18.0.0"
    },
    "devDependencies": {
        "@types/react": "^18.0.0",
        "@types/react-dom": "^18.0.0",
        "typescript": "^5.6.3"
    }
}